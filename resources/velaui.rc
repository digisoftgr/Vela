<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE gui SYSTEM "kpartgui.dtd">
<gui name="vela" version="9">
  <MenuBar>
    <Menu name="file"><text>&amp;File</text>
      <Action name="new_folder"/>
      <Separator/>
      <Action name="new_tab"/>
      <Action name="close_tab"/>
    </Menu>
    <Menu name="edit"><text>&amp;Edit</text>
      <Action name="edit_undo"/>
      <Separator/>
      <Action name="copy_to_other"/>
      <Action name="move_to_other"/>
    </Menu>
    <Menu name="view"><text>&amp;View</text>
      <Action name="toggle_sidebar"/>
      <Action name="toggle_terminal"/>
      <Action name="focus_terminal"/>
      <Action name="show_operations"/>
      <Separator/>
      <Action name="command_palette"/>
    </Menu>
    <Menu name="go"><text>&amp;Go</text>
      <Action name="go_back"/>
      <Action name="go_forward"/>
      <Action name="go_up"/>
      <Action name="go_home"/>
      <Separator/>
      <Action name="refresh"/>
    </Menu>
    <Menu name="bookmarks"><text>&amp;Bookmarks</text></Menu>
    <Menu name="tools"><text>&amp;Tools</text></Menu>
  </MenuBar>
  <ToolBar name="mainToolBar">
    <text>Main Toolbar</text>
    <Action name="go_back"/>
    <Action name="go_forward"/>
    <Action name="go_up"/>
    <Action name="go_home"/>
    <Separator/>
    <Action name="refresh"/>
    <Separator/>
    <Action name="command_palette"/>
    <Separator/>
    <Action name="operations_indicator"/>
  </ToolBar>
</gui>
